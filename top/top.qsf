set_location_assignment PIN_1 -to echo3
set_location_assignment PIN_73 -to trig1
set_location_assignment PIN_74 -to trig2
set_location_assignment PIN_75 -to trig3
set_location_assignment PIN_135 -to left[0]
set_location_assignment PIN_137 -to left[1]
set_location_assignment PIN_132 -to right[0]
set_location_assignment PIN_133 -to right[1]
